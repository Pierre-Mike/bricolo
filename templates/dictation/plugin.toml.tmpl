name = "__NAME__"
version = "0.1.0"
description = "Records on a chord, transcribes on the next press, and pastes the text at the cursor."
# Standard library interfaces the component imports. `bricolo check` fails if
# the component imports one that is not listed here.
imports = ["log", "hotkey", "timer", "mic", "speech", "clipboard", "keyboard", "ui"]
# No disk grant: mic writes into this plugin's own data folder, which
# speech.transcribe-file accepts.
# The built component, relative to this folder. Only `bricolo install` reads it.
wasm = "__WASM__"

# Defaults passed to init as JSON. Override them in node.toml under
# [plugins.__NAME__]. `speech` needs a [speech] server in node.toml.
[settings]
chord = "ctrl+alt+cmd+d"
max_secs = 60
# "ctrl+v" on Linux; "" leaves the text on the clipboard.
paste = "cmd+v"
