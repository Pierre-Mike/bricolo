//! The logic, with no capability calls and no generated bindings, so
//! `cargo test` runs it natively.

/// The run number after `stored`, the value kept in kv.
pub fn next_run(stored: Option<&str>) -> u64 {
    stored.and_then(|s| s.parse::<u64>().ok()).unwrap_or(0) + 1
}

/// The line logged at start. `config` is the settings JSON from `init`.
pub fn greeting(config: &str, runs: u64) -> String {
    let greeting = serde_json::from_str::<serde_json::Value>(config)
        .ok()
        .and_then(|c| c["greeting"].as_str().map(String::from))
        .unwrap_or_else(|| "hello".into());
    format!("{greeting} (run {runs})")
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn counts_runs_from_kv() {
        assert_eq!(next_run(None), 1);
        assert_eq!(next_run(Some("41")), 42);
        assert_eq!(next_run(Some("junk")), 1);
    }

    #[test]
    fn greets_with_the_configured_word() {
        assert_eq!(greeting(r#"{"greeting":"hi"}"#, 2), "hi (run 2)");
        assert_eq!(greeting("{}", 1), "hello (run 1)");
    }
}
