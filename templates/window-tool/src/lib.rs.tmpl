//! __NAME__: centers the focused window on the screen it is on, at
//! `size_percent` of the screen's visible frame, when you press the chord
//! in its settings (ctrl+alt+shift+m by default).
//!
//! `domain.rs` holds the geometry as plain functions, tested with
//! `cargo test`. This file is the adapter: it calls the capabilities and
//! converts between WIT records and domain types.
//!
//! Build:   cargo build --target wasm32-wasip2 --release
//! Check:   bricolo check .
//! Install: bricolo install . -y
//! Try it:  bricolo fire __NAME__ center

// The generated `event` bindings take more than seven arguments.
#![allow(clippy::too_many_arguments)]

mod domain;

use std::sync::OnceLock;

wit_bindgen::generate!({
    path: "__WIT__",
    world: "bricolo:stdlib/plugin",
});

use domain::Area;
use bricolo::stdlib::log::{self, Level};
use bricolo::stdlib::window::{self, Rect};
use bricolo::stdlib::hotkey;

/// The binding id. `bricolo fire __NAME__ center` sends it too.
const CENTER: &str = "center";

static SETTINGS: OnceLock<domain::Settings> = OnceLock::new();

fn area(r: Rect) -> Area {
    Area {
        x: r.x,
        y: r.y,
        width: r.width,
        height: r.height,
    }
}

fn rect(a: Area) -> Rect {
    Rect {
        x: a.x,
        y: a.y,
        width: a.width,
        height: a.height,
    }
}

struct Plugin;

impl Guest for Plugin {
    async fn init(config: String) -> Result<(), String> {
        let settings = SETTINGS.get_or_init(|| domain::Settings::from_json(&config));
        // A chord another program holds fails to bind. Log it and keep
        // running, so `bricolo fire` still reaches the plugin.
        match hotkey::bind(CENTER.into(), settings.chord.clone()).await {
            Ok(()) => log::write(
                Level::Info,
                &format!("press {} to center the focused window", settings.chord),
            ),
            Err(e) => log::write(
                Level::Warn,
                &format!("cannot bind {}: {e:?}", settings.chord),
            ),
        }
        Ok(())
    }

    async fn on_event(event: Event) {
        match event {
            Event::Hotkey(id) if id == CENTER => match center().await {
                Ok(done) => log::write(Level::Info, &done),
                Err(e) => log::write(Level::Warn, &e),
            },
            _ => {}
        }
    }

    async fn dispose() {}
}

async fn center() -> Result<String, String> {
    let settings = SETTINGS.get().cloned().unwrap_or_default();
    let focused = window::focused()
        .await
        .map_err(|e| format!("focused: {e:?}"))?
        .ok_or("no focused window")?;
    let screens: Vec<domain::Screen> = window::screens()
        .await
        .map_err(|e| format!("screens: {e:?}"))?
        .into_iter()
        .map(|s| domain::Screen {
            frame: area(s.frame),
            visible: area(s.visible_frame),
            main: s.main,
        })
        .collect();
    let screen = domain::screen_for(area(focused.frame), &screens).ok_or("no screens")?;
    let target = domain::centered(screen.visible, settings.size_percent);
    window::set_frame(focused.id, rect(target))
        .await
        .map_err(|e| format!("set-frame: {e:?}"))?;
    Ok(format!(
        "centered {} at {},{} {}x{}",
        focused.app, target.x, target.y, target.width, target.height
    ))
}

export!(Plugin);
