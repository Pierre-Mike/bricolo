//! __NAME__: on the chord in its settings (ctrl+alt+shift+p by default),
//! sends the clipboard text to a sidecar, a local HTTP server the node
//! runs (`bricolo new-sidecar`, `bricolo sidecar add`), and shows the answer in a
//! toast. With no text on the clipboard it sends a sample, so
//! `bricolo fire __NAME__ process-clipboard` always makes one request.
//!
//! `domain.rs` holds the logic as plain functions, tested with
//! `cargo test`. This file is the adapter: it calls the capabilities and
//! passes their results to the domain.
//!
//! Build:   cargo build --target wasm32-wasip2 --release
//! Check:   bricolo check .
//! Install: bricolo install . -y
//! Try it:  bricolo fire __NAME__ process-clipboard

// The generated `event` bindings take more than seven arguments.
#![allow(clippy::too_many_arguments)]

mod domain;

use std::sync::OnceLock;

wit_bindgen::generate!({
    path: "__WIT__",
    world: "bricolo:stdlib/plugin",
});

use bricolo::stdlib::log::{self, Level};
use bricolo::stdlib::{clipboard, hotkey, http, ui};

/// The binding id. `bricolo fire __NAME__ process-clipboard` sends it too.
const PROCESS: &str = "process-clipboard";

static SETTINGS: OnceLock<domain::Settings> = OnceLock::new();

struct Plugin;

impl Guest for Plugin {
    async fn init(config: String) -> Result<(), String> {
        let settings = SETTINGS.get_or_init(|| domain::Settings::from_json(&config));
        // A chord another program holds fails to bind. Log it and keep
        // running, so `bricolo fire` still reaches the plugin.
        match hotkey::bind(PROCESS.into(), settings.chord.clone()).await {
            Ok(()) => log::write(
                Level::Info,
                &format!("press {} to send the clipboard to {}", settings.chord, settings.url),
            ),
            Err(e) => log::write(
                Level::Warn,
                &format!("cannot bind {}: {e:?}", settings.chord),
            ),
        }
        Ok(())
    }

    async fn on_event(event: Event) {
        match event {
            Event::Hotkey(id) if id == PROCESS => process_clipboard().await,
            _ => {}
        }
    }

    async fn dispose() {}
}

async fn process_clipboard() {
    let settings = SETTINGS.get().cloned().unwrap_or_default();
    let clip = clipboard::get().await.ok().flatten();
    let text = domain::text_to_send(clip.as_deref());
    let request = http::Request {
        method: "POST".into(),
        url: settings.url.clone(),
        headers: vec![("content-type".into(), "text/plain; charset=utf-8".into())],
        body: text.into_bytes(),
        timeout_ms: Some(settings.timeout_ms),
    };
    let answer = match http::send(request).await {
        Ok(response) => domain::read_answer(response.status, &response.body),
        // `unavailable` usually means the sidecar is not running: check
        // `bricolo sidecar list`.
        Err(e) => Err(format!("cannot reach {}: {e:?}", settings.url)),
    };
    match answer {
        Ok(text) => {
            log::write(Level::Info, &format!("sidecar answered: {}", domain::preview(&text, 80)));
            show(domain::preview(&text, 500)).await;
        }
        Err(why) => {
            log::write(Level::Warn, &why);
            show(why).await;
        }
    }
}

/// Shows `text` in a toast from the hub.
async fn show(text: String) {
    let _ = ui::show_panel(&ui::Panel {
        kind: ui::PanelKind::Toast,
        title: "__NAME__".into(),
        text,
        choices: Vec::new(),
        timeout_ms: None,
    });
}

export!(Plugin);
